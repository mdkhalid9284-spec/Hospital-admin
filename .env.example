# ==========================================
# HospitalCare System Environment Configuration
# ==========================================

# Server Configuration
# Backend listens on this port. Vite proxies /api → http://127.0.0.1:5000
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin (backend only). Never commit a real private key.
# In Vercel, paste the service-account private_key and keep the \n escapes;
# the server converts them to real newlines.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Frontend Firebase web config belongs in frontend/.env (Vite), not here.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Authentication Secrets (Generate secure 32+ char random keys in production)
JWT_SECRET=development-jwt-secret-do-not-use-in-production-hospitalcare-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=development-jwt-refresh-secret-do-not-use-in-production-key
JWT_REFRESH_EXPIRES_IN=7d

# Primary Database (MongoDB)
# Copy the exact SRV URI from Atlas > Database > your cluster > Connect > Drivers.
# Never commit real credentials. URL-encode special characters in the password.
# For a local MongoDB instance use: mongodb://localhost:27017/hospitalcare
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hospitalcare?retryWrites=true&w=majority

# Relational Financial & Audit Database (PostgreSQL / SQLite adapter)
# Options: 'sqlite' | 'postgres'
SQL_DATABASE_TYPE=sqlite
SQL_DATABASE_PATH=./storage/hospitalcare_financial.sqlite
# POSTGRES_URL=postgresql://user:password@localhost:5432/hospitalcare_financial

# File Storage Configuration
# Local development keeps files on disk. Production on Vercel must use the
# private Blob store connected to the backend service.
# STORAGE_DRIVER=local | vercel-blob
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10

# Required only when STORAGE_DRIVER=vercel-blob.
# On Vercel this is injected by the connected private Blob store.
# Never expose this token to the frontend or commit a real value.
# BLOB_READ_WRITE_TOKEN=

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Notification Provider (Options: 'mock' | 'smtp')
NOTIFICATION_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=no-reply@hospitalcare.local
